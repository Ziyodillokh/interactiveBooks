# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
.turbo/
*.tsbuildinfo
coverage/
# app outputs are anchored so a source folder named build/ or out/ is never ignored by accident
apps/*/.next/
apps/*/out/
apps/*/build/

# environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# logs / temp
*.log
tmp/

# tool caches
.eslintcache
